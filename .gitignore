# ============================================================
#  VERDANT — .gitignore
#  This repository is public. Customer data must never be
#  committed. The data files below are created locally by
#  server.js on first run, so a fresh clone needs no setup.
# ============================================================

# ---- Private customer data (never commit) ----
data/orders.json
data/contacts.json
data/subscribers.json
data/*.json
!data/products.json
!data/products.seed.json
!data/.gitkeep

# Temporary / partial writes from the safe-write routine
data/*.tmp

# ---- Environment & secrets ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Session data ----
sessions/
*.session
.cookie-jar
cookies.txt

# ---- Editors & OS files ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- Dependencies (the project intentionally has none) ----
node_modules/
package-lock.json
package.json

# ---- Build output & caches ----
dist/
build/
.cache/
coverage/
*.tsbuildinfo

# ---- Local backups ----
*.bak
*.backup
backup/

# Local admin credentials written by set-admin-password.js
admin-login.json
